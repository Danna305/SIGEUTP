{
  "name": "sigep-utp-admin",
  "version": "1.0.0",
  "description": "SIGEP UTP · Módulo 2: Administración y gestión académica (PWA + API REST con Node.js y Express)",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
